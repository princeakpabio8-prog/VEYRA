# ─── VEYRA environment variables ─────────────────────────────────────────────
# Copy this file to .env.local for local development.
# Set these as environment variables in Vercel for production.
# NEVER commit .env.local to git — it is listed in .gitignore.

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of this deployment (used for metadataBase, OG images, etc.)
# Vercel sets this automatically via @veyra_app_url secret.
# Local default falls back to https://veyra.ai in app/layout.tsx.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
#
# NEXT_PUBLIC_* vars are safe to expose to the browser.
# VEYRA uses only the publishable (anon) key — RLS enforces all row security.
# The service-role key is NOT used and should NOT be set here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-anon-key>

# ─── Voice provider (future) ──────────────────────────────────────────────────
# Not yet active — voice provider adapters are not implemented.
# Set when connecting real voice infrastructure.
# VOICE_PROVIDER=vapi
# VAPI_API_KEY=<your-vapi-api-key>
# VAPI_WEBHOOK_SECRET=<your-vapi-webhook-secret>
# TWILIO_ACCOUNT_SID=<your-account-sid>
# TWILIO_AUTH_TOKEN=<your-auth-token>
# TWILIO_PHONE_NUMBER=<your-twilio-number>
# RETELL_API_KEY=<your-retell-api-key>
# RETELL_WEBHOOK_SECRET=<your-retell-webhook-secret>

# ─── Payments (future) ────────────────────────────────────────────────────────
# Not yet active — payment logic is not implemented.
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# ─── PayPal Sandbox ───────────────────────────────────────────────────────────
# Active — used by lib/paypal/client.ts (server-only).
# Credentials from: developer.paypal.com → Apps & Credentials → Sandbox app.
# Copy the Client ID and Secret for your sandbox application.
# Switch PAYPAL_BASE_URL to https://api-m.paypal.com for production.
PAYPAL_CLIENT_ID=<your-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<your-sandbox-client-secret>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
